# RepoMedic Frontend Production Deployment Environment Configuration Example
# Copy to .env.local for local overrides or configure in your deployment hosting service

# Transport mode: "http" for live backend API or "mock" for offline synthetic test mode
NEXT_PUBLIC_API_TRANSPORT=http

# Frontend API base URL (must include the /api prefix, e.g. /api for Next.js rewrites or https://backend.domain/api when accessing a remote backend directly)
NEXT_PUBLIC_API_URL=/api

# Target backend service URL used by Next.js server rewrites in next.config.ts
BACKEND_URL=http://127.0.0.1:8000

# Public documentation and repository link
NEXT_PUBLIC_DOCS_URL=https://github.com/SGOD-pro/repo-medic

# Port for Next.js production server
PORT=3000
