# ==============================================================================
# RepoMedic Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp .env.example .env
#
# Defaults match backend/src/config.py (Settings)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Mode & Frontend Integration
# ------------------------------------------------------------------------------
# Execution mode: "offline" (fake adapters, zero cost), "replay", or "live" (real models/sandboxes)
REPOMEDIC_MODE=offline

# Allowed frontend origin (CORS / Proxy)
REPOMEDIC_APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cloudflare D1 Database Bridge
# ------------------------------------------------------------------------------
# URL for the private Cloudflare Worker D1 database bridge API
REPOMEDIC_DB_WORKER_URL=http://127.0.0.1:8787

# Bearer token for authenticating requests with the Cloudflare Worker bridge
# (Sent in HTTP header: "Authorization: Bearer <token>")
DB_BRIDGE_TOKEN=local-bridge-token
REPOMEDIC_DB_WORKER_TOKEN=local-bridge-token

# ------------------------------------------------------------------------------
# 3. Budgets, Deadlines & Safety Limits
# ------------------------------------------------------------------------------
# Maximum spend allowed per individual run in USD
REPOMEDIC_MAX_RUN_USD=2.0

# Total global spend budget cap in USD across all runs
REPOMEDIC_TOTAL_BUDGET_USD=25.0

# Max model calls allowed per run (1 for sequential, <=6 for branch/refine)
REPOMEDIC_MAX_MODEL_CALLS=1

# Maximum token count generated per completion call
REPOMEDIC_MAX_OUTPUT_TOKENS=2048

# Run execution deadline / timeout in seconds
REPOMEDIC_RUN_TIMEOUT_SECONDS=600

# Maximum size in bytes per artifact stored in D1 (1MB = 1048576)
REPOMEDIC_MAX_ARTIFACT_BYTES=1048576

# ------------------------------------------------------------------------------
# 4. Nebius Token Factory (Model Inference)
# ------------------------------------------------------------------------------
# Base URL for the OpenAI-compatible Token Factory chat completion API
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model identifier for completions
TOKEN_FACTORY_MODEL=nvidia/nemotron-3-super-120b-a12b

# ------------------------------------------------------------------------------
# 5. Nebius Sandbox (ConTree SDK Execution)
# ------------------------------------------------------------------------------
# contree-sdk (ContreeSync) requires only these two environment variables:
#   export NEBIUS_API_KEY="your_api_key"
#   export NEBIUS_PROJECT_ID="your_project_id"
NEBIUS_API_KEY=v1.xxxx
NEBIUS_PROJECT_ID=aiproject-xxxxxx

# Default container image used for sandboxes (e.g. client.images.use("python:3.12-slim"))
NEBIUS_SANDBOX_IMAGE=python:3.12-bookworm
